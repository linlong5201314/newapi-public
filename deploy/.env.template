# M5 生产环境变量模板（deploy/.env.template）
#
# 用途：
#   1) 人工部署时复制为 .env 填值；
#   2) 节点管理「一键部署」以此模板生成 plan diff（NodeDeployEnvTemplate 为空时的回落）。
# 注意：值为空的键会进入 plan warnings，要求通过 envOverrides 补齐；密钥绝不入库。

# ── 共享云 DB（Supabase 项目 Settings → Database → Connection Pooling，端口 6543）──
SQL_DSN=

# ── 独立 Upstash Redis（rediss://default:...@...upstash.io:6379）──
REDIS_CONN_STRING=

# ── 会话/加密密钥（CRYPTO_SECRET 未设置时敏感字段以 plain: 前缀落库并启动 WARN）──
SESSION_SECRET=
CRYPTO_SECRET=

# ── OmniRoute sidecar（同 Railway 项目内网地址；不用可留空）──
OMNIROUTE_BASE_URL=

# ── Railway RAILPACK/mise 构建坑：python artifact attestation 校验会挂 ──
MISE_PYTHON_GITHUB_ATTESTATIONS=false

# ── 节点角色：主节点 master（自动迁移），其余节点 slave；默认 master ──
NODE_TYPE=master
# NODE_NAME=

# ── 可选：邮件（注册验证码 / 节点余额告警邮件）──
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_ACCOUNT=
# SMTP_TOKEN=
# SMTP_FROM=
# SMTP_SSL_ENABLED=false
# SMTP_STARTTLS_ENABLED=true

# ── 可选：Cloudflare（节点 failover / 自定义域名 TXT / Worker KV）走 Option 配置，不放环境变量 ──
# CLOUDFLARE_API_ENDPOINT=   # 仅 e2e mock 使用

# ── 仅 e2e/mock：Railway GraphQL 端点覆盖（生产留空用官方端点）──
# RAILWAY_GRAPHQL_ENDPOINT=
