{
  "listen": "0.0.0.0:3066",
  "api_key": "",
  "upstream": {
    "llm_base": "https://xiaohuanxiong.com/api/web/llm/v2",
    "auth_base": "https://xiaohuanxiong.com/api/web/auth/v1",
    "points_base": "https://xiaohuanxiong.com/api/web/points/v1",
    "origin": "https://xiaohuanxiong.com",
    "connect_timeout_seconds": 30,
    "response_header_timeout_seconds": 120,
    "request_timeout_seconds": 0,
    "refresh_timeout_seconds": 30,
    "catalog_timeout_seconds": 10,
    "balance_timeout_seconds": 20,
    "bills_timeout_seconds": 25,
    "insecure_skip_verify": false,
    "user_agent": "xhx2api/0.1.0",
    "extra_headers": {}
  },
  "accounts": {
    "file": "/app/data/accounts.json",
    "strategy": "round_robin",
    "refresh_margin_seconds": 300,
    "cooldown_seconds": 600,
    "max_attempts": 3,
    "refresh_on_401": true
  },
  "models": {
    "default": "sn-glm-5-3-flash",
    "validate": "catalog",
    "catalog_cache_seconds": 600,
    "catalog_cache_file": "./data/model_catalog.json"
  },
  "log": {
    "level": "info",
    "access_log": true,
    "buffer_size": 500,
    "file": ""
  },
  "admin": {
    "enabled": true,
    "api_key": "",
    "title": "小浣熊反代"
  },
  "checkin": {
    "enabled": true,
    "time": "00:01",
    "on_start": true,
    "verify_bills": true,
    "bills_limit": 20,
    "retry_interval_minutes": 30,
    "max_attempts_per_day": 5,
    "history_file": "./data/checkin.json",
    "history_days": 30
  },
  "login": {
    "enabled": true,
    "app_name": "办公小浣熊客户端",
    "state_ttl_seconds": 600
  },
  "shutdown_timeout_seconds": 10
}